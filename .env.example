# --- Shared (always) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
TOKEN_ENCRYPTION_KEY_V1=
RETENTION_DAYS=30

# --- 1) Local insecure Docker: `docker compose up --build` ---
# Compose overrides DATABASE_* / insecure flags / owner id.
# You only need Google OAuth + TOKEN_ENCRYPTION_KEY_V1 in `.env`.
# See README “Docker setups → Local insecure”.

# --- 2) Neon production Docker ---
#   cp .env.example .env.neon
#   docker compose -f docker-compose.neon.yml up --build
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DATABASE_DRIVER=neon-http
NEON_AUTH_BASE_URL=https://your-project.neon.tech
NEON_AUTH_COOKIE_SECRET=
OWNER_NEON_AUTH_USER_ID=
# For a public deploy, set GOOGLE_REDIRECT_URI to your HTTPS callback.
# Do NOT set INSECURE_LOCAL_DEV or ALLOW_INSECURE_LOCAL_DEV.

# Hybrid host app + Compose Postgres only ---
# APP_PROFILE=local-compose
# INSECURE_LOCAL_DEV=true
# ALLOW_INSECURE_LOCAL_DEV=I_UNDERSTAND
# DATABASE_DRIVER=pg
# DATABASE_URL=postgresql://emailtriager:emailtriager@localhost:5432/email_triager
# OWNER_NEON_AUTH_USER_ID=local-dev-owner

# Fixture Gmail / public demo (no Google account) ---
# APP_PROFILE=demo   # or ci — uses DeterministicGmailFake seeded from adversarial corpus
# DATABASE_DRIVER=pg
# DATABASE_URL must be emailtriager_app (NOBYPASSRLS), never the Neon/Postgres owner.
# After bun run db:migrate, apply demo SQL: DEMO_APP_DB_PASSWORD=… bun run db:migrate:demo
# DEMO_APP_DB_PASSWORD=   # sets emailtriager_app password (local Compose default: emailtriager)
# Do not set demo/ci with a BYPASSRLS owner URL on a public host — see README “Unlock public demo on Vercel”.

# Shadow audit / judge (Slice 4) — OpenAI only for now ---
# OpenAI HTTP API (or a base URL that speaks the same protocol).
# Required to start POST /api/audit. Not needed for sync or matching eval.
# MODEL_PROVIDER=openai-compatible
MODEL_NAME=gpt-5.4
MODEL_BASE_URL=https://api.openai.com/v1
# Plaintext sk-… or encryptSecret ciphertext (v1.…) using TOKEN_ENCRYPTION_KEY_V1.
MODEL_API_KEY=

# OTel → Langfuse (issue #18) — optional; app works with these unset (ADR-0005).
# Manual spans only; no auto-instrumentation. Postgres remains system of record.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Or a generic OTLP HTTP exporter (Phoenix/Braintrust later — D-3):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://example/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20tok
# OTEL_EXPORTER=none
# OTEL_SERVICE_NAME=email-triager
