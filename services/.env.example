# Required for terraform apply — never commit this file (gitignored as services/.env).
NEON_API_KEY=
NEON_ORG_ID=
VERCEL_API_TOKEN=

# Terraform picks these up as input variables (must match NEON_ORG_ID / optional team).
TF_VAR_neon_org_id=

# spike (default) = IP-locked personal deploy. demo = public APP_PROFILE=demo.
# TF_VAR_deployment_mode=spike

# Spike: comma-separated IPv4/CIDRs that may hit the Vercel app. Required unless demo.
# Check yours: curl -sS https://api.ipify.org
TF_VAR_allowed_cidrs=

# Demo unlock only — password for emailtriager_app (NOBYPASSRLS). >=16 chars.
# Must match GitHub Actions secret DEMO_APP_DB_PASSWORD used by db:migrate:demo.
# TF_VAR_deployment_mode=demo
# TF_VAR_demo_app_db_password=

# Optional: also enable Vercel platform Trusted IPs (needs a plan that includes it; ignored in demo).
# TF_VAR_enable_vercel_trusted_ips=true

# TF_VAR_vercel_team_id=
# TF_VAR_github_repo=noahpatterson/emailTriager
# TF_VAR_neon_region=aws-us-east-1
# TF_VAR_vercel_project_name=email-triager
# TF_VAR_neon_project_name=email-triager-public
