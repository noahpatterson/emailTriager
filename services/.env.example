# Required for terraform apply — never commit this file (gitignored as services/.env).
NEON_API_KEY=
NEON_ORG_ID=
VERCEL_API_TOKEN=

# Terraform picks these up as input variables (must match NEON_ORG_ID / optional team).
TF_VAR_neon_org_id=
# TF_VAR_vercel_team_id=
# TF_VAR_github_repo=noahpatterson/emailTriager
# TF_VAR_neon_region=aws-us-east-1
# TF_VAR_vercel_project_name=email-triager
# TF_VAR_neon_project_name=email-triager-public
