# Copy to services/personal/.env and restrict its filesystem permissions.
# Empty values deliberately fail readiness. Never paste secret values into chat.
APP_PROFILE=personal
DATABASE_DRIVER=neon-http
PERSONAL_GMAIL_WRITES_ENABLED=true
PERSONAL_EXTERNAL_AI_ENABLED=true
RETENTION_DAYS=30

# Production runtime values. Upload only these and the settings above to Vercel production.
# Use the pooled connection for the dedicated emailtriager_personal_app role with sslmode=require.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_NEON_AUTH_USER_ID=
# Generate 32 random bytes encoded as canonical base64. Keep the key for existing encrypted records.
TOKEN_ENCRYPTION_KEY_V1=
# Required for the requested AI contest classification.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional additional model for audit/judge features.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# Local operations only. Never upload these to Vercel or existing CI.
PERSONAL_DATABASE_URL_UNPOOLED=
PERSONAL_APP_DB_PASSWORD=
VERCEL_API_TOKEN=
# Project/account IDs are nonsecret. Account ID must be the owning user or team ID.
VERCEL_PROJECT_ID=
VERCEL_ACCOUNT_ID=
VERCEL_TEAM_ID=
# HCP organization for Terraform. Supply in your shell before terraform init.
TF_CLOUD_ORGANIZATION=
TF_VAR_project_name=email-triager-personal
TF_VAR_team_id=
TF_VAR_gmail_writes_enabled=true
TF_VAR_external_ai_enabled=true
