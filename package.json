  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.5.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
